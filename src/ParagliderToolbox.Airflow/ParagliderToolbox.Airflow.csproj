<Project Sdk="Microsoft.NET.Sdk">

  <!-- The airflow simulator without UI and without dependencies, so a game can use it as it is: soundings, the sun,
       surface heating from the land cover, the fluid solver over a heightfield and the saved airflow field with its
       sampling. -->
  <PropertyGroup>
    <RootNamespace>ParagliderToolbox.Airflow</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The solver is numeric hot loops: optimized even in Debug builds. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ParagliderToolbox.Tests" />
    <InternalsVisibleTo Include="ParagliderToolbox.Airflow.Gpu" />
  </ItemGroup>

</Project>
