<Project>
  <PropertyGroup>
    <!-- The Atelier UI framework is expected next to this repository (D:\GitHub\Atelier); override with /p:AtelierRoot=... -->
    <AtelierRoot Condition="'$(AtelierRoot)' == ''">$(MSBuildThisFileDirectory)..\Atelier\</AtelierRoot>
    <AtelierSrc>$(AtelierRoot)src\</AtelierSrc>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
